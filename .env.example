# ─────────────────────────────────────────────────────────────────
# Salla MCP Server — Environment Variables
# ─────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# Never commit your .env file to version control.

# ── APIDog (Knowledge Layer) ──────────────────────────────────────
# The APIDog site ID for the Salla Partner documentation.
# Default is already set to 451700 — only change if instructed.
APIDOG_SITE_ID=451700

# ── Transport Mode ───────────────────────────────────────────────────
# Set to true when deploying as a web service (Railway, Render, etc.)
# so the server exposes /sse, /messages, and /health over HTTP.
# Leave unset or false for local stdio-based MCP clients.
HTTP_MODE=false

# ── Salla Partner Credentials (Action Layer) ──────────────────────
# Required only when action tools are enabled.
# Get these from: https://partners.salla.com/apps → Your App → Credentials
SALLA_CLIENT_ID=
SALLA_CLIENT_SECRET=
